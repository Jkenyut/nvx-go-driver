# =============================================================================
# GO GENERAL
# =============================================================================
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries
*.test
*.out
*.prof

# Build output
/bin/
/dist/
/build/
/tmp/

# Go workspace file (if using multi-module)
go.work
go.work.sum

# Dependency cache & vendor (optional, uncomment if using vendor)
# vendor/

# Coverage & profiling
coverage.*
*.coverprofile

# =============================================================================
# JETBRAINS / GOLAND / INTELLIJ
# =============================================================================
# Project files
.idea/
*.iws
*.iml
*.ipr

# Generated files & caches
out/
cmake-build-*/

# User-specific (most frequently changed & sensitive)
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/aws.xml
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml
.idea/**/mongoSettings.xml
.idea/**/httpRequests/
.idea/**/sonarlint/

# Gradle/Maven auto-import (ignore even if unused)
.idea/**/gradle.xml
.idea/**/libraries
.idea/artifacts/
.idea/compiler.xml
.idea/jarRepositories.xml
.idea/modules.xml

# =============================================================================
# CONFIG & SECRETS (very important!)
# =============================================================================
# Local config (never commit original configs!)
config.yaml
config.yml
config.local.*
.env
.env.local
.env.*.local
secrets/
*.pem
*.key
*.crt

# But keep the example config!
# !config.example.yaml
# !config.example.yml

# =============================================================================
# OS & EDITOR
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Vim
*.swp
*.swo
*~

# VS Code (if anyone uses it)
.vscode/

# =============================================================================
# MISC
# =============================================================================
# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/

# Crash reports
*.dmp

# =============================================================================
# ALLOWED (do not ignore)
# =============================================================================
# Ensure config example files remain in git
!config.example.yaml
!config.example.yml
!.env.example
!docker-compose.yml
!Dockerfile

# Added by code-review-graph
.code-review-graph/
.agents/

# Added by graphify
graphify-out/
AGENTS.md
GEMINI.md

skills-lock.json